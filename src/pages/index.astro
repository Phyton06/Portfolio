    // Smooth accordion: measure the real height and animate open AND close
    // symmetrically (native ::details-content only animates opening).
    (function () {
      var details = document.querySelectorAll('.proj-details');
      for (var i = 0; i < details.length; i++) {
        (function (d) {
          var body = d.querySelector('.d-body');
          var summary = d.querySelector('summary');
          var openHeight = 0; // real open height, captured before it changes
          var first = []; // FLIP: card tops before the grid reflows
          summary.addEventListener('click', function () {
            // fires BEFORE the state flips: capture the true open height
            if (d.open) openHeight = body.getBoundingClientRect().height;
            var cards = document.querySelectorAll('.project-card');
            first = [];
            for (var j = 0; j < cards.length; j++) first.push(cards[j].getBoundingClientRect().top);
          });
          d.addEventListener('toggle', function () {
            if (d.open) {
              // expand: from 0 to the real content height
              body.style.height = '0px';
              void body.offsetHeight; // reflow to start the transition
              body.style.height = body.scrollHeight + 'px';
            } else {
              // collapse: from the captured open height down to 0
              var h = openHeight || body.getBoundingClientRect().height;
              body.style.height = h + 'px';
              void body.offsetHeight;
              body.style.height = '0px';
            }
            flipCards();
          });
          d.addEventListener('transitionend', function (e) {
            if (e.target !== body || e.propertyName !== 'height') return;
            if (d.open) {
              // freeze the measured height so a later close starts from it
              body.style.height = body.scrollHeight + 'px';
            }
          });
          // FLIP: grid placement changes are instant, so slide the cards
          // that moved (siblings reflow when a card expands/collapses).
          function flipCards() {
            var cards = document.querySelectorAll('.project-card');
            var moved = [], deltas = [];
            for (var j = 0; j < cards.length; j++) {
              var dy = first[j] - cards[j].getBoundingClientRect().top;
              if (Math.abs(dy) < 1) continue;
              moved.push(cards[j]); deltas.push(dy);
              cards[j].style.transition = 'none';
              cards[j].style.transform = 'translateY(' + dy + 'px)';
            }
            if (!moved.length) return;
            void document.body.offsetHeight; // commit the inverted positions
            for (var j = 0; j < moved.length; j++) {
              moved[j].style.transition = 'transform 0.7s cubic-bezier(0.22, 1, 0.36, 1)';
              moved[j].style.transform = '';
            }
            setTimeout(function () {
              for (var j = 0; j < moved.length; j++) moved[j].style.transition = '';
            }, 800);
          }
        })(details[i]);
      }
    })();
  </script>

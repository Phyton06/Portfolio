      --bg-3: #16161f;
      --fg: #ececf1;
      --fg-dim: #9d9daa;
      --fg-faint: #63636f;
      --green: #2ee06d;
      --cyan: #38d0f0;
      --amber: #f5b842;
      --red: #f06a5a;
      --border: rgba(255,255,255,0.10);
      --border-strong: rgba(255,255,255,0.20);

      function lang() { return window.__lang === 'es' ? 'es' : 'en'; }
      function printLines(html) {
        pre.innerHTML += html + '<br />';
      }
      function renderIntro() {
        pre.innerHTML = T[lang()].intro;
      }
      function execute(cmd) {
        var d = T[lang()];
        switch (cmd) {
          case 'help':
            printLines(d.help);
            break;
          case 'about':
          case 'whoami':
            d.about.forEach(printLines);
            break;
          case 'stack':
            d.stack.forEach(printLines);
            break;
          case 'projects':
            d.projects.forEach(printLines);
            break;
          case 'contact':
            d.contact.forEach(printLines);
            break;
          case 'exit':
            printLines(d.exit);
            break;
          case 'clear':
            pre.innerHTML = '';
            break;
          case 'sudo':
            printLines(d.sudo);
            break;
          default:
            printLines(d.notFound + ' <span class="dim">' + cmd + '</span> ' + d.type);
        }
        body.scrollTop = body.scrollHeight;
      }

      renderIntro();
      var hasOutput = false;
      document.addEventListener('langchange', function () {
        if (!hasOutput) renderIntro();
      });
      var buffer = '';
      current.textContent = '';
      function render() { current.textContent = buffer; }

      function handleKey(e) {
        if (e.key === 'Enter') {
          var cmd = buffer.trim();
          if (cmd !== '') {
            printLines('<span class="ok">phyton06@dev:~$</span> <span class="b">' + cmd + '</span>');
            execute(cmd);
            hasOutput = true;
          }
          buffer = '';
          render();
          e.preventDefault();
        } else if (e.key === 'Backspace') {
          buffer = buffer.slice(0, -1);
          render();
          e.preventDefault();
        } else if (e.key.length === 1 && !e.ctrlKey && !e.metaKey && !e.altKey) {
          buffer += e.key;
          render();
          e.preventDefault();
        }
      }
      document.addEventListener('keydown', handleKey);
      body.addEventListener('click', function () { body.focus(); });
      body.setAttribute('tabindex', '0');

      // Mobile: hidden input for keyboard
      var termInput = document.getElementById('termInput');
      if (termInput) {
        body.addEventListener('click', function () { termInput.focus(); });
        termInput.addEventListener('input', function () {
          var val = termInput.value;
          if (val) {
            for (var i = 0; i < val.length; i++) {
              buffer += val[i];
            }
            termInput.value = '';
            render();
          }
        });
        termInput.addEventListener('keydown', function (e) {
          if (e.key === 'Enter') {
            var cmd = buffer.trim();

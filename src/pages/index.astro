      font-family: var(--font-mono); font-size: 13px; color: var(--fg-faint);
      margin-bottom: 22px; letter-spacing: 0.02em;
    }
    .hero .tagline .green { color: var(--green); }
    .hero h1 {
      margin: 0 0 8px;
      font-size: clamp(40px, 8vw, 88px);
      line-height: 0.98;
      letter-spacing: -0.04em;
      font-weight: 700;
    }
    .hero h1 .outline {
      color: transparent;
      -webkit-text-stroke: 1.5px var(--fg);
    }
    .hero .sub {
      font-size: clamp(16px, 2.2vw, 20px); color: var(--fg-dim);
      max-width: 60ch; margin: 18px 0 36px;
    }
    .hero .sub strong { color: var(--fg); }

    /* terminal */
    .term {
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      background: var(--bg-2);
      box-shadow: 0 24px 80px rgba(0,0,0,0.35), 0 4px 16px rgba(0,0,0,0.2);
      overflow: hidden;
    }
    .term-bar {
      display: flex; align-items: center; gap: 8px;
      padding: 12px 16px;
      background: var(--bg-3);
      border-bottom: 1px solid var(--border);
    }
    .term-dot { width: 11px; height: 11px; border-radius: 50%; }
    .term-dot.r { background: #ff5f57; }
    .term-dot.y { background: #febc2e; }
    .term-dot.g { background: #28c840; }
    .term-title { margin-left: 10px; font-family: var(--font-mono); font-size: 12px; color: var(--fg-faint); }
    .term-title .green { color: var(--green); }
    .term-body {
      padding: 22px 20px 26px;
      font-family: var(--font-mono); font-size: 13.5px; line-height: 1.7;
      min-height: 340px;
    }
    .term-body .l { color: var(--fg-faint); }
    .term-body .ok { color: var(--green); }
    .term-body .err { color: var(--red); }
    .term-body .cy { color: var(--cyan); }
    .term-body .am { color: var(--amber); }
    .term-body .dim { color: var(--fg-dim); }
    .term-body .b { color: var(--fg); font-weight: 600; }
    .term-body .dbl { margin: 8px 0; }
    .term-body pre { margin: 0; white-space: pre-wrap; word-break: break-word; font-family: inherit; }
    .term-input {
      position: absolute; left: -9999px; width: 1px; height: 1px;
      opacity: 0; pointer-events: none;
    }
    .term-line { display: flex; align-items: center; gap: 8px; margin-top: 10px; flex-wrap: wrap; }
    .term-prompt { color: var(--green); white-space: nowrap; }
    .term-cmd { color: var(--fg); }
    .term-caret { display: inline-block; width: 8px; height: 15px; background: var(--green); vertical-align: text-bottom; animation: blink 1.1s steps(1) infinite; }
    @keyframes blink { 50% { opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .term-caret { animation: none; opacity: 0.6; } }
    .term-help { font-size: 12px; color: var(--fg-faint); margin-top: 14px; }

    /* ---- sections ---- */
    section { padding: 0 0 var(--space); }
    .sec-head { display: flex; align-items: baseline; gap: 16px; margin-bottom: 44px; flex-wrap: wrap; }
    .sec-line { flex: 1; height: 1px; background: var(--border); min-width: 40px; }
    .sec-num { font-family: var(--font-mono); font-size: 13px; color: var(--green); }
    .sec-title { font-size: clamp(28px, 4.5vw, 42px); font-weight: 700; letter-spacing: -0.03em; margin: 0; }
    .sec-comment { font-family: var(--font-mono); font-size: 12.5px; color: var(--fg-faint); }

    /* whoami */
    .whoami { display: grid; gap: 32px; }
    .whoami p { font-size: clamp(17px, 2.4vw, 21px); color: var(--fg-dim); margin: 0 0 18px; line-height: 1.6; max-width: 70ch; }
    .whoami p strong { color: var(--fg); font-weight: 600; }
    .whoami .sig { font-family: var(--font-mono); font-size: 13px; color: var(--fg-faint); line-height: 2; }

    /* stack */
    .stack-grid { display: grid; gap: 14px; grid-template-columns: 1fr; }
    .stack-group {
      border: 1px solid var(--border); border-radius: var(--radius);
      background: var(--bg-2); overflow: hidden;
      transition: border-color 0.2s ease, transform 0.2s ease;
    }
    .stack-group:hover { border-color: var(--border-strong); transform: translateY(-3px); }
    .sg-head {
      display: flex; align-items: center; gap: 10px;
      padding: 13px 16px; background: var(--bg-3);
      border-bottom: 1px solid var(--border);
      font-family: var(--font-mono); font-size: 12px; color: var(--fg-faint);
    }
    .sg-head .dir { color: var(--cyan); }
    .sg-head .caret { color: var(--green); }
    .sg-body { padding: 16px; }
    .stack-items { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip {
      font-family: var(--font-mono); font-size: 12.5px; color: var(--fg);
      border: 1px solid var(--border); border-radius: 7px;
      padding: 5px 11px; background: var(--bg);
      display: inline-flex; align-items: center; gap: 6px;
      transition: border-color 0.15s ease, color 0.15s ease;
    }
    .chip:hover { border-color: var(--green); color: var(--green); }
    .chip img { width: 13px; height: 13px; flex: none; }
    :root[data-theme="dark"] .chip img[src*="expo"] { filter: invert(1); }
    :root[data-theme="dark"] img[src*="github"] { filter: invert(1); }
    :root[data-theme="dark"] img[src*="mail"] { filter: invert(1); }

    /* projects */
    .projects-grid { display: grid; gap: 16px; grid-template-columns: 1fr; grid-auto-flow: dense; }
    .project-card {
      border: 1px solid var(--border); border-radius: var(--radius);
      background: var(--bg-2); overflow: hidden;
      display: flex; flex-direction: column;
      transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease;
    }
    .project-card:hover { border-color: var(--border-strong); transform: translateY(-4px); box-shadow: 0 20px 48px rgba(0,0,0,0.18); }
    /* expanded project becomes a full-row panel with multi-column detail */
    .project-card:has(.proj-details[open]) { grid-column: 1 / -1; border-color: var(--border-strong); }
    .project-card:has(.proj-details[open]):hover { transform: none; }
    .project-card:has(.proj-details[open]) .proj-body { display: grid; grid-template-columns: 1fr; align-items: start; column-gap: 24px; }
    .project-card:has(.proj-details[open]) h3 { font-size: 26px; }
    .project-card:has(.proj-details[open]) .proj-body p { font-size: 15.5px; max-width: 62ch; }
    .project-card:has(.proj-details[open]) .proj-stack { justify-content: flex-start; }
    .project-card:has(.proj-details[open]) .proj-details { margin-top: 0; }
    .project-card:has(.proj-details[open]) .d-body { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }

    /* ultra-smooth accordion: height is measured and animated by JS in both
       directions (native ::details-content only animates opening; the
       allow-discrete keeps the content painted while JS collapses it) */
    .proj-details::details-content {
      transition: content-visibility 0.7s allow-discrete;
    }
    .proj-details .d-body {
      height: 0; overflow: hidden;
      opacity: 0; transform: translateY(10px);
      transition: height 0.7s cubic-bezier(0.22, 1, 0.36, 1), opacity 0.7s ease, transform 0.7s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .proj-details[open] .d-body { opacity: 1; transform: none; }
    .proj-details[open] .d-body { opacity: 1; transform: none; }
    .proj-head {
      display: flex; align-items: center; gap: 10px;
      padding: 12px 16px; background: var(--bg-3);
      border-bottom: 1px solid var(--border);
      font-family: var(--font-mono); font-size: 12px; color: var(--fg-faint);
    }
    .proj-head .folder { color: var(--amber); }
    .proj-head .name { color: var(--fg); font-weight: 600; }
    .proj-head .lang { margin-left: auto; color: var(--cyan); }
    .proj-body { padding: 20px; display: flex; flex-direction: column; gap: 12px; flex: 1; }
    .proj-body h3 { font-size: 21px; font-weight: 700; letter-spacing: -0.02em; margin: 0; }
    .proj-body p { font-size: 14.5px; color: var(--fg-dim); margin: 0; line-height: 1.6; }
    .proj-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: auto; }
    .proj-stack .chip { font-size: 11.5px; padding: 3px 9px; background: var(--bg); }
    .proj-stack .chip::before { content: ""; }
    /* project expandable detail */
    .proj-details { border-top: 1px solid var(--border); margin-top: auto; }
    .proj-details summary {
      cursor: pointer; list-style: none;
      display: flex; align-items: center; gap: 8px;
      font-family: var(--font-mono); font-size: 12.5px; font-weight: 600;
      color: var(--green);
      user-select: none;
    }
    .proj-details summary::-webkit-details-marker { display: none; }
    .proj-details summary .caret { color: var(--green); display: inline-block; transition: transform 0.18s ease; }
    .proj-details[open] summary .caret { transform: rotate(90deg); }
    .proj-details summary:active { transform: scale(0.97); }
    /* CTA — línea de enlace con subrayado que crece */
    .cta-underline { width: fit-content; margin: 14px 20px 20px; padding: 0; position: relative; transition: color 0.2s ease; }
    .cta-underline::after { content: ""; position: absolute; left: 0; right: 0; bottom: -2px; height: 1px; background: var(--green); transform: scaleX(0); transform-origin: left; transition: transform 0.25s ease; }
    .cta-underline:hover::after { transform: scaleX(1); }
    .proj-details .d-body { padding: 0 20px 20px; }
    .proj-details .d-block { margin-bottom: 12px; }
    .proj-details .d-block:last-child { margin-bottom: 0; }
    .proj-details .d-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-faint); margin-bottom: 4px; }
    .proj-details .d-label .green { color: var(--green); }
    .proj-details .d-text { font-size: 14px; color: var(--fg-dim); line-height: 1.6; margin: 0; }
    /* highlighted result banner: spans the full row, sits above the descriptive grid */
    .proj-details .d-result {
      grid-column: 1 / -1;
      border: 1px solid var(--green); border-radius: var(--radius);
      background: var(--bg-3); padding: 14px 18px; margin-bottom: 4px;
    }
    .proj-details .d-result .d-text { font-size: 15px; color: var(--fg); }
    .proj-details .d-result .d-label { color: var(--green); }

    /* leadership */
    .leadership-list { display: grid; gap: 12px; }
    .leadership-item {
      display: grid; grid-template-columns: 96px 1fr; gap: 22px;
      border: 1px solid var(--border); border-radius: var(--radius);
      background: var(--bg-2); padding: 22px 24px;
      transition: border-color 0.2s ease;
    }
    .leadership-item:hover { border-color: var(--border-strong); }
    .l-year { font-family: var(--font-mono); font-size: 13px; color: var(--amber); padding-top: 3px; }
    .l-year::before { content: "● "; font-size: 10px; }
    .l-title { font-size: 18px; font-weight: 650; margin: 0 0 4px; letter-spacing: -0.01em; }
    .l-desc { font-size: 14.5px; color: var(--fg-dim); margin: 0; }

    /* contact */
    .contact-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 16px; }
    .contact-item {
      display: flex; flex-direction: column; align-items: center; gap: 10px;
      padding: 24px 16px; border: 1px solid var(--border); border-radius: var(--radius);
      background: var(--bg-2); text-decoration: none; color: inherit;
      transition: border-color 0.2s ease, transform 0.2s ease;
      font-family: inherit; font-size: inherit; text-align: center;
    }
    .contact-item:hover { border-color: var(--green); transform: translateY(-3px); }
    .contact-icon { width: 40px; height: 40px; color: var(--fg); transition: color 0.2s ease; }
    .contact-item:hover .contact-icon { color: var(--green); }
    .contact-label { font-family: var(--font-mono); font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-faint); }
    .contact-value { font-size: 14px; font-weight: 600; color: var(--fg); text-align: center; }
    .contact-item:hover .contact-value { color: var(--green); }
    button.contact-item { cursor: pointer; width: 100%; }

    footer { border-top: 1px solid var(--border); padding: 30px 0; text-align: center; }
    footer .mono { font-size: 13px; color: var(--fg-faint); }
    footer .green { color: var(--green); }

    /* ---- responsive ---- */
    @media (min-width: 640px) {
      .stack-grid { grid-template-columns: repeat(2, 1fr); }
      .projects-grid { grid-template-columns: repeat(2, 1fr); }
    }
    @media (min-width: 1024px) {
      .stack-grid { grid-template-columns: repeat(3, 1fr); }
      .projects-grid { grid-template-columns: repeat(3, 1fr); }
    }
    @media (max-width: 1023px) {
      .project-card:has(.proj-details[open]) .d-body { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 639px) {
      .nav-links { display: none; }
      .term-body { cursor: text; }
      .project-card:has(.proj-details[open]) .proj-body { grid-template-columns: 1fr; }
      .project-card:has(.proj-details[open]) .proj-stack { justify-content: flex-start; }
      .project-card:has(.proj-details[open]) .d-body { grid-template-columns: 1fr; }
      .contact-grid { grid-template-columns: 1fr; }
    }
  </style>
</head>
